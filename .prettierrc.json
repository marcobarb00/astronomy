{
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 120,
	"singleQuote": true,
	"trailingComma": "none",
	"arrowParens": "avoid",
	"bracketSpacing": true,
	"quoteProps": "preserve",
	"semi": true,
	"endOfLine": "lf",
	"overrides": [
		{
			"files": "*.css",
			"options": {
				"singleQuote": false
			}
		}
	]
}
